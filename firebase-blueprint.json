{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information, level, status and preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "username": { "type": "string" },
        "photoURL": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "balance": { "type": "number" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "isOnline": { "type": "boolean" },
        "lastSeen": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "isBanned": { "type": "boolean" },
        "bio": { "type": "string" },
        "isShadowBanned": { "type": "boolean" },
        "level": { "type": "string", "enum": ["Bronze", "Silver", "Gold"] },
        "experience": { "type": "number" }
      },
      "required": ["uid", "email"]
    },
    "Contact": {
      "title": "Contact",
      "description": "A saved contact for a user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "savedAt": { "type": "string" }
      },
      "required": ["uid"]
    },
    "Message": {
      "title": "Message",
      "description": "A chat message between users, groups, or channels.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "text": { "type": "string" },
        "status": { "type": "string" },
        "type": { "type": "string" },
        "timestamp": { "type": "object" }
      },
      "required": ["senderId", "receiverId", "text"]
    },
    "GroupOrChannel": {
      "title": "Group or Channel",
      "description": "A group chat or announcement channel.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "isGroup": { "type": "boolean" },
        "isChannel": { "type": "boolean" },
        "displayName": { "type": "string" },
        "creatorId": { "type": "string" },
        "members": { "type": "array" },
        "admins": { "type": "array" }
      },
      "required": ["uid", "displayName", "creatorId"]
    },
    "Call": {
      "title": "Call",
      "description": "A voice or video call log and signaling data.",
      "type": "object",
      "properties": {
        "callerId": { "type": "string" },
        "receiverId": { "type": "string" },
        "status": { "type": "string" },
        "type": { "type": "string" },
        "timestamp": { "type": "object" }
      },
      "required": ["callerId", "receiverId", "status", "type"]
    },
    "Status": {
      "title": "Status",
      "description": "A user's visual/text story/status update.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "imageUrl": { "type": "string" },
        "caption": { "type": "string" },
        "timestamp": { "type": "object" },
        "views": { "type": "array" }
      },
      "required": ["userId", "imageUrl"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "A global announcement or notice.",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "type": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "object" }
      },
      "required": ["text", "type"]
    },
    "SupportTicket": {
      "title": "Support Ticket",
      "description": "A user help or support ticket.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "status": { "type": "string" },
        "lastMessage": { "type": "string" },
        "updatedAt": { "type": "object" }
      },
      "required": ["userId", "status"]
    },
    "ActivityLog": {
      "title": "Activity Log",
      "description": "A log of user actions for audit purposes.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "action": { "type": "string" },
        "timestamp": { "type": "object" }
      },
      "required": ["userId", "action"]
    },
    "Notification": {
      "title": "Notification",
      "description": "A pending system push notification.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" },
        "userId": { "type": "string" },
        "timestamp": { "type": "object" }
      },
      "required": ["title", "body"]
    },
    "Book": {
      "title": "Book",
      "description": "A book in the Islamic Library.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "author": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["title"]
    },
    "SystemConfig": {
      "title": "System Config",
      "description": "System configuration parameters.",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "value": { "type": "string" }
      },
      "required": ["key"]
    },
    "AppSettings": {
      "title": "App Settings",
      "description": "Global application setting document.",
      "type": "object",
      "properties": {
        "isMaintenanceMode": { "type": "boolean" },
        "globalAnnouncement": { "type": "string" }
      }
    }
  },
  "firestore": {
    "users": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Collection of user profiles."
    },
    "users/{userId}/contacts": {
      "schema": { "$ref": "#/entities/Contact" },
      "description": "Sub-collection of saved contacts for each user."
    },
    "messages": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Collection of chat messages."
    },
    "groups": {
      "schema": { "$ref": "#/entities/GroupOrChannel" },
      "description": "Collection of group chats and channels."
    },
    "calls": {
      "schema": { "$ref": "#/entities/Call" },
      "description": "Collection of call signals and logs."
    },
    "statuses": {
      "schema": { "$ref": "#/entities/Status" },
      "description": "Collection of user status/stories."
    },
    "announcements": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Collection of global announcements."
    },
    "supportTickets": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "Collection of admin/user support tickets."
    },
    "activityLogs": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Collection of user/admin activity logs."
    },
    "notifications": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Collection of queued system notifications."
    },
    "library_books": {
      "schema": { "$ref": "#/entities/Book" },
      "description": "Collection of Islamic library books."
    },
    "system_configs": {
      "schema": { "$ref": "#/entities/SystemConfig" },
      "description": "Collection of key-value system configurations."
    },
    "settings": {
      "schema": { "$ref": "#/entities/AppSettings" },
      "description": "Collection of settings documents (like settings/global)."
    }
  }
}
