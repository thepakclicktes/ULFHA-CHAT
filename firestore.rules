rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} { allow read, write: if true; }
    match /users/{userId}/contacts/{contactId} { allow read, write: if true; }
    match /messages/{messageId} { allow read, write: if true; }
    match /groups/{groupId} { allow read, write: if true; }
    match /calls/{callId} { allow read, write: if true; }
    match /statuses/{statusId} { allow read, write: if true; }
    match /announcements/{announcementId} { allow read, write: if true; }
    match /supportTickets/{ticketId} { allow read, write: if true; }
    match /activityLogs/{logId} { allow read, write: if true; }
    match /notifications/{notificationId} { allow read, write: if true; }
    match /library_books/{bookId} { allow read, write: if true; }
    match /system_configs/{configId} { allow read, write: if true; }
    match /settings/{settingId} { allow read, write: if true; }
  }
}
